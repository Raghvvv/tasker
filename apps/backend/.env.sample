task_app_PRIMARY.ENV="local"

task_app_SERVER.PORT="8080"
task_app_SERVER.READ_TIMEOUT="30"
task_app_SERVER.WRITE_TIMEOUT="30"
task_app_SERVER.IDLE_TIMEOUT="60"
task_app_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

task_app_DATABASE.HOST="localhost"
task_app_DATABASE.PORT="5432"
task_app_DATABASE.USER="postgres"
task_app_DATABASE.PASSWORD=""
task_app_DATABASE.NAME="task_app"
task_app_DATABASE.SSL_MODE="disable"
task_app_DATABASE.MAX_OPEN_CONNS="25"
task_app_DATABASE.MAX_IDLE_CONNS="25"
task_app_DATABASE.CONN_MAX_LIFETIME="300"
task_app_DATABASE.CONN_MAX_IDLE_TIME="300"

task_app_AUTH.SECRET_KEY="secret"

task_app_INTEGRATION.RESEND_API_KEY="resend_key"

task_app_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
task_app_OBSERVABILITY.SERVICE_NAME="task_app"
task_app_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
task_app_OBSERVABILITY.LOGGING.LEVEL="debug"
task_app_OBSERVABILITY.LOGGING.FORMAT="console"
task_app_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
task_app_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
task_app_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
task_app_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
task_app_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
task_app_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
task_app_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
task_app_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
task_app_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"